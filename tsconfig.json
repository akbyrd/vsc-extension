{
	"compilerOptions": {
		"module": "nodenext",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
			"ES2020",
			"DOM",
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"types": ["node"],
	},
	"include": ["src/**/*.ts"]
}
