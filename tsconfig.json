{
	"compilerOptions": {
		"module": "nodenext",
		"target": "es2022",
		"outDir": "out",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"types": ["node"],
	},
	"include": ["src/**/*.ts"]
}
