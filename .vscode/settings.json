{
	"search.exclude": {
		"out": true,
	},

	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
	"js/ts.tsc.autoDetect": "off",

	// Use the installed version, instead of the one bundled with vscode
	"js/ts.tsdk.path": "node_modules\\typescript\\lib",

	// Disable inspector.open so the extension doesn't auto-attach (this slows tests down massively)
	// Not properly escaped, but it works and is more readable.
	"nodejs-testing.extensions": [
		{
			"extensions": ["js"],
			"parameters": ["--import", "data:text/javascript,import i from 'node:inspector'; i.open = () => {}"]
		}
	],
}
